# Copy to .env (never commit it). Use URL-safe passwords (letters and digits).
POSTGRES_PASSWORD=change-me
CHESHIRE_APP_DB_PASSWORD=change-me-too
# Migrations run as the owner; the API connects as `cheshire_app` (no DDL).
CHESHIRE_OWNER_DATABASE_URL=postgresql://cheshire:change-me@db:5432/cheshire
CHESHIRE_DATABASE_URL=postgresql://cheshire_app:change-me-too@db:5432/cheshire
# Cookies are Secure by default (TLS proxy in front). Plain-http local use only:
CHESHIRE_COOKIE_SECURE=false
CHESHIRE_LANGUAGE=en
CHESHIRE_LLM_PROVIDER=openai
CHESHIRE_LLM_API_KEY=
# Models are configuration; choose them per role (no default).
CHESHIRE_LLM_INTERPRETER_MODEL=
CHESHIRE_LLM_WRITER_MODEL=
CHESHIRE_LLM_INTERVIEWER_MODEL=
CHESHIRE_LLM_MEDIATOR_MODEL=
# Days without activity before the decider of a discussion is nudged
# CHESHIRE_DISCUSSION_NUDGE_DAYS=7
# Work-queue claims expire after this many days unless renewed (catalog maintenance)
# CHESHIRE_CLAIM_TTL_DAYS=7
# Any OpenAI-compatible endpoint (a local server works too):
# CHESHIRE_LLM_BASE_URL=https://api.openai.com/v1
# Host ports (both bound to 127.0.0.1)
CHESHIRE_DB_PORT=5432
CHESHIRE_API_PORT=8000
CHESHIRE_WEB_PORT=8080
